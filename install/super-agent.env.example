# super-agent.env.example — /etc/super-agent/.env 的键清单（只有键名与占位符，无真值）
#
# 用法：新服务器上先跑 scripts/apply-secrets.sh（把 secrets/deepseek.env 的
# DeepSeek 键落到 /etc/super-agent/.env，0600），再按本文件补齐其余键。
# GitHub token、Tavily 键不进仓库，在部署机上单独配置。
# BACKUP_SERVER_ID 改成新服务器的编号。
DEEPSEEK_API_KEY=<见私密库 secrets/deepseek.env，或跑 scripts/apply-secrets.sh>
WORKER_MODEL=<见私密库 secrets/deepseek.env>
ADVISOR_MODEL=<见私密库 secrets/deepseek.env>
ADVISOR_MODE=<见私密库 secrets/deepseek.env>
TIMEOUT_SEC=<见私密库 secrets/deepseek.env>
MAX_OUTPUT_CHARS=<见私密库 secrets/deepseek.env>
GITHUB_TOKEN=<部署机单独配置，不进仓库>
TAVILY_API_KEY=<部署机单独配置，不进仓库>
TAVILY_PASSWORD=<部署机单独配置，不进仓库>
BACKUP_ENABLED=1
BACKUP_REPO=ip9988001/super-agent-007
BACKUP_SERVER_ID=<新服务器编号，如 VM124655>
BACKUP_TOKEN_KEY=GITHUB_TOKEN
BACKUP_REPO_DIR=/root/super-agent-backup
CHROME_PATH=/root/super-agent-007/tools/scripts/chrome-with-nosandbox
